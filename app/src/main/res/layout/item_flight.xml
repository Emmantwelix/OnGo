<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">


        <TextView
            android:id="@+id/originTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="@id/originText"
            app:layout_constraintTop_toTopOf="parent"/>


        <TextView
            android:id="@+id/destinationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="@id/destinationText"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/airlines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Porter Airlines"
            android:textSize="12sp"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="@id/arrowIcon"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/originText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toronto"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginEnd="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon"
            app:layout_constraintTop_toBottomOf="@id/originTime"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@android:color/black"
            android:contentDescription="To"
            app:layout_constraintStart_toEndOf="@id/originText"
            app:layout_constraintEnd_toStartOf="@id/destinationText"
            app:layout_constraintTop_toTopOf="@id/originText"
            app:layout_constraintBottom_toBottomOf="@id/originText"/>


        <TextView
            android:id="@+id/destinationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vancouver"
            android:textSize="16sp"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toEndOf="@id/arrowIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/destinationTime"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

