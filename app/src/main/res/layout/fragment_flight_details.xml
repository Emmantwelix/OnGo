<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_flight_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Timeline Column -->
            <View
                android:id="@+id/timeline_dot_top"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/baseline_flight_24"
                android:backgroundTint="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_depart_time"
                app:layout_constraintBottom_toBottomOf="@id/text_depart_time"/>

            <View
                android:id="@+id/timeline_line"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:background="#BDBDBD"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/timeline_dot_bottom"
                app:layout_constraintEnd_toEndOf="@+id/timeline_dot_top"
                app:layout_constraintStart_toStartOf="@+id/timeline_dot_top"
                app:layout_constraintTop_toBottomOf="@+id/timeline_dot_top" />

            <View
                android:id="@+id/timeline_dot_bottom"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/baseline_flight_24"
                android:backgroundTint="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_arrival_time"
                app:layout_constraintBottom_toBottomOf="@id/text_arrival_time"/>

            <!-- Departure Section -->
            <TextView
                android:id="@+id/text_depart_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/timeline_dot_top"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="04:00 PM" />

            <TextView
                android:id="@+id/text_origin_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#9E9E9E"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/text_depart_time"
                app:layout_constraintStart_toEndOf="@id/text_depart_time"
                app:layout_constraintTop_toTopOf="@id/text_depart_time"
                tools:text="MON" />

            <TextView
                android:id="@+id/text_origin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/text_depart_time"
                app:layout_constraintTop_toBottomOf="@id/text_depart_time"
                tools:text="Montreal" />

            <!-- Middle Section (Flight Info & Duration) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="48dp"
                app:layout_constraintBottom_toTopOf="@+id/text_arrival_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/text_depart_time"
                app:layout_constraintTop_toBottomOf="@+id/text_origin_name">

                <TextView
                    android:id="@+id/text_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    tools:text="2hr 0min" />

                <TextView
                    android:id="@+id/text_airline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="WestJet" />

                <TextView
                    android:id="@+id/text_flight_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="13sp"
                    tools:text="Flight 4" />
            </LinearLayout>

            <!-- Arrival Section -->
            <TextView
                android:id="@+id/text_arrival_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="180dp"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/timeline_dot_bottom"
                app:layout_constraintTop_toBottomOf="@id/text_depart_time"
                tools:text="06:00 PM" />

            <TextView
                android:id="@+id/text_dest_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#9E9E9E"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/text_arrival_time"
                app:layout_constraintStart_toEndOf="@id/text_arrival_time"
                app:layout_constraintTop_toTopOf="@id/text_arrival_time"
                tools:text="WIN" />

            <TextView
                android:id="@+id/text_dest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/text_arrival_time"
                app:layout_constraintTop_toBottomOf="@id/text_arrival_time"
                tools:text="Winnipeg" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/card_flight_details">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Price"
                android:textColor="#757575"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="$417.38" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/black"
        android:text="Continue to Booking"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
